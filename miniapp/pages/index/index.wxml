<scroll-view class="page" scroll-y enable-back-to-top>
  <view class="header">
    <text class="header-title">📊 税案通报大数据仪表盘</text>
    <text class="header-sub">国家税务总局 · 1,103 条记录 · 2021-2026</text>
  </view>

  <view class="kpi-grid">
    <view class="kpi-card" wx:for="{{kpis}}" wx:key="label" style="border-left-color: {{item.color}}">
      <text class="kpi-label">{{item.label}}</text>
      <text class="kpi-value">{{item.value}}</text>
      <text class="kpi-sub">{{item.sub}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">📈 年度曝光趋势</text>
      <text class="section-badge">2022峰值623条</text>
    </view>
    <canvas canvas-id="chartYearly" class="chart-canvas"></canvas>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">🗓 月度发稿节奏</text>
      <text class="section-badge">37个月</text>
    </view>
    <canvas canvas-id="chartMonthly" class="chart-canvas"></canvas>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">🥧 案件类型分布</text>
      <text class="section-badge">7类</text>
    </view>
    <canvas canvas-id="chartType" class="chart-canvas"></canvas>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">🌏 省份曝光排名</text>
      <text class="section-badge">Top 10</text>
    </view>
    <canvas canvas-id="chartProvince" class="chart-canvas"></canvas>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">📅 每日分布（潮汐效应）</text>
      <text class="section-badge">26-28日高峰</text>
    </view>
    <canvas canvas-id="chartDay" class="chart-canvas"></canvas>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">📋 关键词频率 Top 10</text>
    </view>
    <canvas canvas-id="chartKeyword" class="chart-canvas"></canvas>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">📋 2026年曝光批次</text>
      <text class="section-badge">{{batches.length}}批</text>
    </view>
    <view class="batch-list">
      <view class="batch-item" wx:for="{{batches}}" wx:key="date">
        <view class="batch-date">{{item.date}}</view>
        <view class="batch-info">
          <text class="batch-title">{{item.title}}</text>
          <text class="batch-count">{{item.count}}篇</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer">
    <text>数据来源：国家税务总局 chinatax.gov.cn</text>
    <text>数据采集：2026-06-09</text>
  </view>
</scroll-view>
