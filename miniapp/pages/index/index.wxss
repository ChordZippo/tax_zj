.page {
  padding: 20rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* Header */
.header {
  background: linear-gradient(135deg, #1a1a2e, #0f3460);
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
}
.header-sub {
  font-size: 24rpx;
  color: #a0aec0;
  margin-top: 10rpx;
  display: block;
}

/* KPI Grid */
.kpi-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.kpi-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  width: calc(33.33% - 12rpx);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #4C72B0;
  box-sizing: border-box;
}
.kpi-label {
  font-size: 20rpx;
  color: #6c757d;
  display: block;
  margin-bottom: 4rpx;
}
.kpi-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
}
.kpi-sub {
  font-size: 20rpx;
  color: #6c757d;
  display: block;
  margin-top: 4rpx;
}

/* Sections */
.section {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.section-badge {
  font-size: 20rpx;
  background: #e9ecef;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: #6c757d;
}
.chart-canvas {
  width: 100%;
  height: 360rpx;
}
.chart-canvas-wide {
  width: 800rpx;
  height: 360rpx;
}
.chart-canvas-half {
  width: 100%;
  height: 400rpx;
}
.chart-scroll {
  width: 100%;
  white-space: nowrap;
}
.chart-scroll::-webkit-scrollbar {
  display: none;
}

/* Split columns */
.section-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.half {
  flex: 1;
  margin-bottom: 0;
  min-width: 0;
}

/* Batch list */
.batch-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.batch-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}
.batch-date {
  font-size: 22rpx;
  font-weight: 600;
  color: #4C72B0;
  white-space: nowrap;
  min-width: 140rpx;
}
.batch-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.batch-title {
  font-size: 24rpx;
  color: #1a1a2e;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}
.batch-count {
  font-size: 20rpx;
  background: #4C72B0;
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

/* Footer */
.footer {
  text-align: center;
  padding: 30rpx 0;
  font-size: 22rpx;
  color: #6c757d;
}
.footer text {
  display: block;
  line-height: 1.8;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}
